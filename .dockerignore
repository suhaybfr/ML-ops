# ================================================================
# .dockerignore — Exclude unnecessary & sensitive files from context
# ================================================================

# Git & CI
.git
.github
.gitignore

# Python caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Notebooks & dev files
notebooks/
*.ipynb
.ipynb_checkpoints/

# Secrets & DVC internal metadata
.env
.dvc/
mlruns/
mlartifacts/

# Tests & lint outputs
tests/
.pytest_cache/
.coverage
coverage.xml
junit-report.xml

# IDE & OS
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
*.swp
*.swo

# Docs, raw/processed datasets, monitoring configs & reports
docs/
*.md
data/
monitoring/
reports/
